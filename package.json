{
  "name": "mapper",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --filter @mapper/menubar tauri dev",
    "build": "pnpm --filter @mapper/menubar tauri build",
    "prepare": "husky",
    "commitlint": "commitlint --config package.json"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "husky": "^9.1.7"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "scope-empty": [
        2,
        "never"
      ]
    }
  }
}
